# ============================================================
# AdForge - environment configuration
# Copy to `.env` and fill in real secrets. Never commit `.env`.
# ============================================================

# --- App ---
APP_ENV=dev                          # dev | staging | prod
APP_LOG_LEVEL=INFO
APP_TENANT_ID=default_tenant         # isolated per customer / workspace
APP_DISABLE_GUARDRAILS=false         # NEVER set to true in prod
APP_SECRET=                           # HMAC key for HITL approval tokens. Required in prod.
APP_REVIEWER_ALLOWLIST=               # comma-separated emails authorised to approve writes
APP_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_AUTH_TOKEN=                       # shared X-API-Key. Required in staging/prod.
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_API_URL=http://localhost:8000
DASHBOARD_HTTP_TIMEOUT=30
DASHBOARD_RUN_TIMEOUT=300

# --- LLM ---
# opencode: OpenAI-compatible endpoint (default; free Coarena key, $5/day usage)
# glm | openai | anthropic are supported if you have their keys.
LLM_PROVIDER=opencode
LLM_BASE_URL=https://coarena.ai/api/v1
LLM_MODEL=gpt-6-luna              # fallback if quota: gemini-3-8-flash
LLM_API_KEY=coa_...               # free key from coarena.ai
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=8192
# Z.ai GLM (optional)
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=adforge
POSTGRES_PASSWORD=adforge_dev_password
POSTGRES_DB=adforge
DATABASE_URL=postgresql+asyncpg://adforge:adforge_dev_password@localhost:5432/adforge

# --- Redis (rate limiter + audit buffer; fails open) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- LangGraph checkpointer ---
# postgres: durable HITL resume (requires Postgres)
# memory:   in-process resume (dev/test only)
# none:     no persistence (HITL cannot resume)
CHECKPOINTER_BACKEND=postgres

# --- MCP server transport ---
MCP_ENABLED=true
MCP_TRANSPORT=stdio                   # stdio | sse | streamable_http
MCP_RESEARCH_PORT=9001
MCP_ADS_PORT=9002
MCP_ANALYTICS_PORT=9003
MCP_ROI_PORT=9004
MCP_COMPLIANCE_PORT=9005
MCP_GOOGLE_ADS_OFFICIAL_PORT=9006     # official googleads/google-ads-mcp container
MCP_PUBLIC_DATA_PORT=9007             # AdForge public-data MCP
MCP_LINKEDIN_PORT=9012                # dedicated LinkedIn Ads MCP
# In Docker Compose these are overridden with service-name URLs.
MCP_HOST=localhost
MCP_SCHEME=http                       # http | https
MCP_BIND_HOST=127.0.0.1               # Docker Compose overrides to 0.0.0.0
MCP_RESEARCH_URL=
MCP_ADS_URL=
MCP_ANALYTICS_URL=
MCP_ROI_URL=
MCP_COMPLIANCE_URL=
MCP_GOOGLE_ADS_OFFICIAL_URL=
MCP_PUBLIC_DATA_URL=
MCP_LINKEDIN_URL=

# --- Public data API keys (optional; tools fail explicitly when blank) ---
# Tavily - paid web search. Optional: DuckDuckGo + Wikipedia are free defaults.
TAVILY_API_KEY=
SIMILARWEB_API_KEY=                    # website traffic + engagement
IPINFO_API_TOKEN=                      # IP geolocation + ASN
ABUSEIPDB_API_KEY=                     # IP reputation
GITHUB_TOKEN=                          # raises API rate limit from 60/hr to 5000/hr
# Free endpoints that need NO key at all:
#   DuckDuckGo HTML, Wikipedia, HackerNews, Reddit, StackExchange,
#   OpenCorporates, Apple iTunes / App Store RSS

# --- External MCP integrations (see docs/RESEARCH.md) ---
# Pipeboard MCP family - hosted remote MCP for Meta + Google + TikTok + Snap + Reddit.
PIPEBOARD_API_TOKEN=
PIPEBOARD_META_URL=https://meta-ads.mcp.pipeboard.co/sse
PIPEBOARD_TIKTOK_URL=https://tiktok-ads.mcp.pipeboard.co/sse
PIPEBOARD_SNAP_URL=https://snap-ads.mcp.pipeboard.co/sse
PIPEBOARD_REDDIT_URL=https://reddit-ads.mcp.pipeboard.co/sse

# Google Ads official MCP - uses Google Cloud ADC (Application Default Credentials)
GOOGLE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/creds/gcp.json

# --- Ad platform endpoints (override only for a gateway or test fixture) ---
GOOGLE_ADS_API_VERSION=v21
GOOGLE_ADS_API_BASE=https://googleads.googleapis.com
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
META_GRAPH_API_VERSION=v21.0
META_GRAPH_BASE=https://graph.facebook.com
LINKEDIN_API_BASE=https://api.linkedin.com
LINKEDIN_API_VERSION=202411
TIKTOK_API_VERSION=v1.3
TIKTOK_API_BASE=https://business-api.tiktok.com

# --- Research / public-data endpoints (override for self-hosted gateways) ---
RESEARCH_SEARCH_URL=https://html.duckduckgo.com/html/
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
TAVILY_BASE_URL=https://api.tavily.com
GOOGLE_SUGGEST_URL=https://suggestqueries.google.com/complete/search
SIMILARWEB_API_BASE=https://api.similarweb.com
ITUNES_API_BASE=https://itunes.apple.com
IPINFO_API_BASE=https://ipinfo.io
ABUSEIPDB_API_BASE=https://api.abuseipdb.com/api/v2
GITHUB_API_BASE=https://api.github.com
HACKERNEWS_API_BASE=https://hacker-news.firebaseio.com/v0
REDDIT_API_BASE=https://www.reddit.com
STACKEXCHANGE_API_BASE=https://api.stackexchange.com/2.3
OPENCORPORATES_API_BASE=https://api.opencorporates.com/v0.4
PRODUCTHUNT_API_URL=https://api.producthunt.com/v2/api/graphql
PRODUCTHUNT_API_TOKEN=
GOOGLE_TRENDS_BASE_URL=https://trends.google.com
JINA_READER_URL=https://r.jina.ai
SEC_EDGAR_API_BASE=https://data.sec.gov/api
WIKIMEDIA_REST_API_BASE=https://wikimedia.org/api/rest_v1
EXTERNAL_HTTP_TIMEOUT=30
EXTERNAL_USER_AGENT=AdForge/0.4 (research-agent)

# --- Ad platform API credentials (blank = explicit error, never fake data) ---
# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Meta / Facebook Marketing
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_AD_LIBRARY_TOKEN=

# LinkedIn Marketing
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# TikTok Ads
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# --- Write safety (disabled by default) ---
# Publishing is delegated to an authenticated adapter webhook. A campaign is
# never launched without an owner approval token AND this explicit opt-in.
ADFORGE_ENABLE_LIVE_WRITES=false
ADFORGE_PUBLISH_WEBHOOK_URL=
ADFORGE_PUBLISH_WEBHOOK_TOKEN=
GUARDRAILS_MAX_CAMPAIGN_BUDGET_USD=1000000

# --- LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adforge-dev

# --- Guardrails ---
GUARDRAILS_MAX_LLM_CALLS_PER_CAMPAIGN=200
GUARDRAILS_MAX_API_CALLS_PER_MIN=60
GUARDRAILS_REQUIRE_COMPLIANCE_APPROVAL=true
AGENT_MAX_TOOL_ITERATIONS=8
AGENT_MAX_TOOL_RESULT_CHARS=16000
