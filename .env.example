# ============================================================
# AdForge — environment configuration
# Copy to `.env` and fill in real secrets. Never commit `.env`.
# ============================================================

# --- App ---
APP_ENV=dev                          # dev | staging | prod
APP_LOG_LEVEL=INFO
APP_TENANT_ID=default_tenant          # isolated per customer / workspace
APP_DISABLE_GUARDRAILS=false          # NEVER set to true in prod
APP_SECRET=                            # HMAC key for HITL approval tokens. Set in prod.
APP_REVIEWER_ALLOWLIST=                # comma-separated emails authorised to approve writes

# --- LLM (default: Z.ai GLM) ---
LLM_PROVIDER=glm                      # glm | openai | anthropic
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-4.6
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=adforge
POSTGRES_PASSWORD=adforge_dev_password
POSTGRES_DB=adforge
DATABASE_URL=postgresql+asyncpg://adforge:adforge_dev_password@localhost:5432/adforge

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- MCP server transport ---
MCP_TRANSPORT=stdio                   # stdio | sse | streamable_http
MCP_RESEARCH_PORT=9001
MCP_ADS_PORT=9002
MCP_ANALYTICS_PORT=9003
MCP_ROI_PORT=9004
MCP_COMPLIANCE_PORT=9005
MCP_GOOGLE_ADS_OFFICIAL_PORT=9006     # official googleads/google-ads-mcp container
MCP_PUBLIC_DATA_PORT=9007            # AdForge public-data MCP (SimilarWeb + AppStore + IPInfo + AbuseIPDB)

# --- Public data API keys (all optional — fall back to free endpoints or mock when blank) ---
# Tavily — paid web search. OPTIONAL: AdForge now uses DuckDuckGo (free) +
# Wikipedia (free) by default; Tavily is only a higher-quality fallback.
TAVILY_API_KEY=
# SimilarWeb — website traffic + engagement. Free tier via Composio Rube MCP.
SIMILARWEB_API_KEY=
# IPInfo — IP geolocation + ASN. 50k/month free tier. https://ipinfo.io
IPINFO_API_TOKEN=
# AbuseIPDB — IP reputation. 1000 checks/day free tier. https://www.abuseipdb.com
ABUSEIPDB_API_KEY=
# GitHub token — raises API rate limit from 60/hr to 5000/hr. Optional.
GITHUB_TOKEN=
# Free public endpoints that need NO key at all:
#   - DuckDuckGo HTML search (replaces Tavily when no key)
#   - Wikipedia public API
#   - HackerNews Firebase API
#   - Reddit JSON API (read-only)
#   - Stack Exchange API
#   - OpenCorporates API (free tier, 100/day)
#   - Apple iTunes / RSS (App Store search)

# --- External MCP integrations (see docs/RESEARCH.md) ---
# Pipeboard MCP family — hosted remote MCP for Meta + Google + TikTok + Snap + Reddit.
# Sign up at pipeboard.co, copy your API token. Free tier exists.
# Leave blank to fall back to local mock ad-platform clients.
PIPEBOARD_API_TOKEN=
PIPEBOARD_META_URL=https://meta-ads.mcp.pipeboard.co/sse
PIPEBOARD_TIKTOK_URL=https://tiktok-ads.mcp.pipeboard.co/sse
PIPEBOARD_SNAP_URL=https://snap-ads.mcp.pipeboard.co/sse
PIPEBOARD_REDDIT_URL=https://reddit-ads.mcp.pipeboard.co/sse

# Tavily web search API (backs the Research agent's MCP)
TAVILY_API_KEY=

# Google Ads official MCP — uses Google Cloud ADC (Application Default Credentials)
GOOGLE_PROJECT_ID=
# Path inside the container. Mount your gcp.json at ./creds/gcp.json locally.
GOOGLE_APPLICATION_CREDENTIALS=/creds/gcp.json

# --- Ad platform API credentials (leave blank to use mock mode) ---
# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_USE_MOCK=true

# Meta / Facebook Marketing
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_USE_MOCK=true

# LinkedIn Marketing
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_USE_MOCK=true

# TikTok Ads
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_USE_MOCK=true

# --- LangGraph tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adforge-dev

# --- Guardrails ---
GUARDRAILS_MAX_LLM_CALLS_PER_CAMPAIGN=200
GUARDRAILS_MAX_API_CALLS_PER_MIN=60
GUARDRAILS_REQUIRE_COMPLIANCE_APPROVAL=true
